# Instagram Graph API / Messenger API
INSTAGRAM_APP_ID=your_app_id
INSTAGRAM_APP_SECRET=your_app_secret
INSTAGRAM_PAGE_ACCESS_TOKEN=your_page_access_token
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your_verify_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_business_account_id

# Trigger
TRIGGER_KEYWORD=BASUSTA

# Discount (shown in DM, no API validation)
STATIC_DISCOUNT_CODE=DESCUENTO_INSTAGRAM

# Database
DATABASE_URL=postgresql://dev:dev@172.17.234.65:5432/instagram_retention?schema=public

# Redis
REDIS_URL=redis://172.17.234.65:6379

# Environment
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
