generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WebhookProcessingStatus {
  PENDING
  PROCESSED
  FAILED
  SKIPPED

  @@map("webhook_processing_status")
}

model InstagramFollower {
  id              String   @id @default(uuid()) @map("id")
  instagramUserId String   @unique @map("instagram_user_id")
  followedAt      DateTime @default(now()) @map("followed_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("instagram_followers")
  @@index([followedAt])
}

model InstagramComment {
  id              String   @id @default(uuid()) @map("id")
  commentId       String   @unique @map("comment_id")
  instagramUserId String   @map("instagram_user_id")
  mediaId         String?  @map("media_id")
  commentText     String   @map("comment_text")
  commentedAt     DateTime @default(now()) @map("commented_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("instagram_comments")
  @@index([instagramUserId])
  @@index([commentedAt])
}

model DmRecord {
  id              String   @id @default(uuid()) @map("id")
  instagramUserId String   @unique @map("instagram_user_id")
  commentId       String?  @map("comment_id")
  mediaId         String?  @map("media_id")
  discountCode    String   @map("discount_code")
  dmMessageId     String?  @map("dm_message_id")
  dmSentAt        DateTime @default(now()) @map("dm_sent_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("dm_records")
  @@index([instagramUserId])
  @@index([dmSentAt])
}

model WebhookEvent {
  id                String                  @id @default(uuid()) @map("id")
  eventType         String                  @map("event_type")
  rawPayload        Json                    @map("raw_payload")
  processingStatus  WebhookProcessingStatus  @default(PENDING) @map("processing_status")
  errorMessage      String?                 @map("error_message")
  instagramUserId   String?                 @map("instagram_user_id")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  @@map("webhook_events")
  @@index([processingStatus])
  @@index([createdAt])
  @@index([instagramUserId])
}